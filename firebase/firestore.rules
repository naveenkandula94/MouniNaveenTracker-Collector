rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function ownsDevice(deviceId) {
      return signedIn() && exists(/databases/$(database)/documents/devices/$(deviceId))
        && get(/databases/$(database)/documents/devices/$(deviceId)).data.collectorUid == request.auth.uid;
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Bootstrap trusted admin docs manually in Firebase Console.
    }
    match /devices/{deviceId} {
      allow read: if isAdmin() && resource.data.adminUid == request.auth.uid;
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['adminUid','collectorUid','displayName','createdAt']);
      allow update, delete: if isAdmin() && resource.data.adminUid == request.auth.uid;
      match /usageEvents/{eventId} {
        allow create: if ownsDevice(deviceId)
          && request.resource.data.keys().hasOnly(['eventId','deviceId','packageName','applicationLabel','eventTimestamp','serverTimestamp','timezone','schemaVersion'])
          && request.resource.data.deviceId == deviceId
          && request.resource.data.eventId == eventId
          && request.resource.data.packageName is string
          && request.resource.data.eventTimestamp is timestamp;
        allow read: if isAdmin() && get(/databases/$(database)/documents/devices/$(deviceId)).data.adminUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
